{
	"name": "purgekit",
	"private": false,
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build assets/src/index.js assets/src/editor.js --output-path=build",
		"start": "wp-scripts start assets/src/index.js assets/src/editor.js --output-path=build",
		"test:js": "wp-scripts test-unit-jest --passWithNoTests",
		"test:php-env": "wp-env run tests-cli --env-cwd=wp-content/plugins/PurgeKit vendor/bin/phpunit -c phpunit-integration.xml.dist"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@wordpress/api-fetch": "^8.2.0",
		"@wordpress/components": "^28.13.0",
		"@wordpress/env": "^12.2.0",
		"@wordpress/scripts": "^37.2.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"packageManager": "pnpm@12.21.0"
}
